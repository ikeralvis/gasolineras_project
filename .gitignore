# ==========================================
# 🚀 PROYECTO GASOLINERAS - GITIGNORE GLOBAL
# ==========================================

# ──────────────────────────────
# 🟢 Node.js (Gateway + Usuarios)
# ──────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json
# pnpm-lock.yaml  # COMENTADO: Este archivo debe estar en Git para builds reproducibles

# Variables de entorno (SOLO archivos con secretos reales)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ⚠️ IMPORTANTE: .env.example SÍ debe subirse a Git (es un template)

# ──────────────────────────────
# 🐍 Python (Microservicio Gasolineras)
# ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
venv/
.env/
instance/
.pytest_cache/
migrations/
*.sqlite3

# ──────────────────────────────
# ⚛️ React (Frontend)
# ──────────────────────────────
frontend-client/node_modules/
frontend-client/.env
frontend-client/.next/
frontend-client/dist/
frontend-client/build/
frontend-client/.cache/
frontend-client/coverage/
frontend-client/public/*.map

# ──────────────────────────────
# 🐳 Docker
# ──────────────────────────────
**/docker-compose.override.yml
*.pid
*.seed
*.log
.docker/
docker-compose.override.yml

# ──────────────────────────────
# 💾 Bases de datos y datos locales
# ──────────────────────────────
mongo_data/
postgres_data/
*.db
*.sqlite

# ──────────────────────────────
# 🧰 IDEs y entornos locales
# ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.bak
.DS_Store
Thumbs.db

# ──────────────────────────────
# 🧪 Tests y coberturas
# ──────────────────────────────
coverage/
test-results/
playwright-report/
junit.xml
*.cover
*.lcov
reports/
__snapshots__/

# ──────────────────────────────
# 🗂️ Otros
# ──────────────────────────────
logs/
*.log
nohup.out
*.tmp
*.temp

# Ignorar dependencias instaladas
node_modules/

# Ignorar archivos de entorno
.env

# Ignorar logs generados por npm o yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignorar archivos de sistema
.DS_Store
Thumbs.db

# No ignorar package.json ni package-lock.json
!package.json
!package-lock.json
!pnpm-lock.yaml
